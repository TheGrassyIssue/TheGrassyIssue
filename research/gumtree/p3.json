<script>
(function () {
  if (!/^\/cart\/?$/.test(location.pathname)) return;
  var LINKS = [['New Arrivals', '/shop/new-arrivals'], ['Headwear', '/shop/headwear'], ['Clothing', '/shop/clothing'], ['Headcovers', '/shop/headcovers'], ['Coffee', '/shop/gumtree-coffee']];
  function run() {
    var root = document.getElementById('sqs-cart-root');
    if (!root) return;
    var title = root.querySelector('.cart-title');
    var empty = root.querySelector('.empty-message');
    // item count
    if (title && !empty) {
      var n = 0;
      root.querySelectorAll('.cart-row').forEach(function (r) {
        var i = r.querySelector('.cart-row-qty input');
        var v = i ? parseInt(i.value, 10) : 1;
        n += isNaN(v) ? 1 : v;
      });
      var txt = n + (n === 1 ? ' item' : ' items');
      var c = title.parentNode.querySelector('.ggnc-cart-count');
      if (!c) { c = document.createElement('span'); c.className = 'ggnc-cart-count'; title.parentNode.appendChild(c); }
      if (c.textContent !== txt) c.textContent = txt;
    }
    // shipping note under subtotal
    var sub = root.querySelector('.cart-subtotal');
    if (sub && !(sub.nextElementSibling && sub.nextElementSibling.classList.contains('ggnc-ship-note'))) {
      var p = document.createElement('p'); p.className = 'ggnc-ship-note';
      p.textContent = 'Shipping & taxes calculated at checkout';
      sub.parentNode.insertBefore(p, sub.nextSibling);
    }
    // empty state
    var box = root.querySelector('.ggnc-empty');
    if (empty && !box) {
      var host = empty.parentNode.parentNode;
      var d = document.createElement('div'); d.className = 'ggnc-empty';
      d.innerHTML = '<h2>Your cart is empty</h2><p>Nothing in here yet. Start with the latest drop from the Nature Club.</p>' +
        '<a class="ggnc-empty-btn" href="/shop/collections/nature-club">Shop the Nature Club</a>' +
        '<div class="ggnc-empty-links">' + LINKS.map(function (l) { return '<a href="' + l[1] + '">' + l[0] + '</a>'; }).join('') + '</div>';
      host.insertBefore(d, empty.parentNode);
    } else if (!empty && box) { box.remove(); }
  }
  var t;
  function sched() { clearTimeout(t); t = setTimeout(run, 30); }
  function start() {
    var root = document.getElementById('sqs-cart-root');
    if (!root) return setTimeout(start, 200);
    run();
    new MutationObserver(sched).observe(root, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ['value'] });
    root.addEventListener('input', sched, true);
    root.addEventListener('change', sched, true);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>
<!-- GGNC: promote main heading to H1 for SEO (ggnc-h1) -->
<script>
(function(){
  var p=location.pathname.replace(/\/$/,'')||'/';
  var ok=p==='/'||p==='/about'||p==='/studio'||(p.indexOf('/shop')===0&&p.indexOf('/shop/p/')!==0);
  if(!ok||document.querySelector('main h1, #page h1'))return;
  var h=document.querySelector('#page h2, main h2');if(!h)return;
  var cs=getComputedStyle(h),n=document.createElement('h1');
  for(var i=0;i<h.attributes.length;i++){n.setAttribute(h.attributes[i].name,h.attributes[i].value)}
  ['fontFamily','fontSize','fontWeight','lineHeight','letterSpacing','textTransform','color','marginTop','marginBottom','textAlign'].forEach(function(k){n.style[k]=cs[k]});
  while(h.firstChild)n.appendChild(h.firstChild);h.parentNode.replaceChild(n,h);
})();
</script>
