<script>
(function () {
  if (!/^\/events\/[^/]+\/?$/.test(location.pathname)) return;
  var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
  function txt(h) { var d = document.createElement('div'); d.innerHTML = h || ''; return (d.textContent || '').trim(); }
  function range(e) {
    var s = new Date(e.startDate), en = new Date(e.endDate || e.startDate);
    var sd = s.getDate(), sm = MONTHS[s.getMonth()], sy = s.getFullYear(), ed = en.getDate(), em = MONTHS[en.getMonth()], ey = en.getFullYear();
    if ((en - s) <= 20 * 3600 * 1000) return sd + ' ' + sm + ' ' + sy;
    if (sm === em && sy === ey) return sd + '–' + ed + ' ' + sm + ' ' + sy;
    if (sy === ey) return sd + ' ' + sm + ' – ' + ed + ' ' + em + ' ' + sy;
    return sd + ' ' + sm + ' ' + sy + ' – ' + ed + ' ' + em + ' ' + ey;
  }
  function money(v) { var m = v && (v.priceMoney || v.price); if (m == null) return ''; var n = typeof m === 'object' ? parseFloat(m.value) : m / 100; return '$' + n.toLocaleString('en-US', { minimumFractionDigits: n % 1 ? 2 : 0 }); }
  function bulletText(p) { return p.textContent.replace(/^\s*[•·\-–*]\s*/, '').trim(); }
  function isBullet(p) { return /^\s*[•·*]/.test(p.textContent); }

  // Turn the ticket description (H3 sections + paragraphs) into tidy sections
  // Split paragraphs that use blank lines (<br><br>) into separate pieces
  function expand(exc) {
    var out = [];
    [].slice.call(exc.children).forEach(function (el) {
      if (el.tagName === 'P' && /<br\s*\/?>\s*<br/i.test(el.innerHTML)) {
        el.innerHTML.split(/(?:<br\s*\/?>\s*){2,}/i).forEach(function (chunk) {
          var p = document.createElement('p'); p.innerHTML = chunk;
          if (p.textContent.trim()) out.push(p);
        });
      } else out.push(el);
    });
    out.forEach(function (p) { [].slice.call(p.querySelectorAll('br')).forEach(function (b) { b.replaceWith(' '); }); });
    return out;
  }
  function labelled(el) {
    var first = el.firstElementChild;
    if (!first || first.tagName !== 'STRONG') return null;
    var lab = first.textContent.trim();
    if (!/:$/.test(lab) || lab.length > 40) return null;
    var rest = el.textContent.trim().slice(first.textContent.trim().length).trim();
    return rest ? { label: lab.replace(/:$/, ''), text: rest } : null;
  }
  function sections(exc) {
    var out = { intro: [], days: [], lists: [], other: [] }, cur = null;
    expand(exc).forEach(function (el) {
      var t = el.textContent.replace(/\s+/g, ' ').trim();
      if (!t) return;
      if (el.tagName === 'UL' || el.tagName === 'OL') {
        var items = [].map.call(el.querySelectorAll('li'), function (li) { return li.textContent.replace(/\s+/g, ' ').trim(); }).filter(Boolean);
        if (cur && cur.type === 'list') cur.items = cur.items.concat(items);
        else { cur = { type: 'list', title: 'Details', items: items, ps: [] }; out.lists.push(cur); }
        return;
      }
      var lab = labelled(el);
      if (lab && cur && cur.type === 'other') { cur.ps.push(lab); return; }
      if (lab && (!cur || cur.type === 'list') && !/^day\b/i.test(lab.label)) { cur = { type: 'other', title: lab.label, ps: [lab.text] }; out.other.push(cur); return; }
      var strongOnly = el.tagName === 'P' && el.querySelector('strong') && el.querySelector('strong').textContent.trim() === t && t.length < 40;
      if (el.tagName === 'H3' || el.tagName === 'H2' || el.tagName === 'H4' || strongOnly) {
        t = t.replace(/:\s*$/, '');
        if (!/[a-z0-9]/i.test(t)) return;
        var m = t.split(/\s+[-–—]\s+/);
        if (/^day\b/i.test(t)) { cur = { type: 'day', label: m[0], note: m.slice(1).join(' – '), ps: [] }; out.days.push(cur); }
        else if (/includ|handle|bring|pack/i.test(t)) { cur = { type: 'list', title: t, items: [], ps: [] }; out.lists.push(cur); }
        else { cur = { type: 'other', title: /transport/i.test(t) ? 'Getting there' : t, ps: [] }; out.other.push(cur); }
        return;
      }
      if (!cur) { out.intro.push(t); return; }
      if (cur.type === 'list' && isBullet(el)) cur.items.push(bulletText(el));
      else if (cur.type === 'list' && cur.items.length && !isBullet(el)) { cur = { type: 'other', title: 'Good to know', ps: [t] }; out.other.push(cur); }
      else cur.ps.push(t);
    });
    return out;
  }

  function signup(panel) {
    var form = panel.querySelector('form'), input = form.querySelector('input'), btn = form.querySelector('button'), msg = panel.querySelector('.ggnc-ed-msg');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent = 'Please enter a valid email address.'; return; }
      var ff = document.querySelector('.sqs-block-newsletter form.newsletter-form');
      if (!ff) { msg.textContent = 'Sign up at the bottom of the page.'; return; }
      var fin = ff.querySelector('input[type=email], input[name=email]'), blk = ff.closest('.sqs-block') || ff.parentElement;
      Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(fin, email);
      fin.dispatchEvent(new Event('input', { bubbles: true })); fin.dispatchEvent(new Event('change', { bubbles: true }));
      btn.disabled = true; msg.textContent = 'Submitting…';
      var start = Date.now();
      (function watch() {
        if (blk.querySelector('.form-submission-text:not(.hidden), .form-submission-html:not(.hidden)')) { panel.classList.add('is-done'); msg.textContent = 'You’re on the list. We’ll be in touch before the next one.'; return; }
        if (Date.now() - start > 9000) { btn.disabled = false; msg.textContent = 'Something went wrong. Please try again.'; return; }
        setTimeout(watch, 250);
      })();
      if (ff.requestSubmit) ff.requestSubmit(); else (ff.querySelector('button, [type=submit]') || {}).click();
    });
  }

  function build(ev, prod) {
    var art = document.querySelector('article.eventitem');
    var block = art && art.querySelector('.product-block');
    var exc = block && block.querySelector('.product-excerpt');
    if (!art || !exc || document.querySelector('.ggnc-ed')) return;

    var e = ev.item, p = prod && prod.item;
    var vars = (p && p.variants) || [];
    var inStock = vars.some(function (v) { return v.unlimited || v.qtyInStock > 0; });
    var left = vars.reduce(function (n, v) { return n + (v.unlimited ? 999 : Math.max(0, v.qtyInStock || 0)); }, 0);
    var past = new Date(e.endDate || e.startDate) < new Date();
    var price = money(vars[0]);
    var prodUrl = p && p.fullUrl;
    var trip = /field trip/i.test(e.title);
    var num = ((p && p.title) || e.title).match(/field trip\s*(\d+)/i);
    var eyebrow = trip ? 'Field Trip' + (num ? ' ' + num[1] : '') : 'Day Pass';
    var name = txt(e.title).replace(/^\s*(ggnc\s+)?field trip\s*(\d+)?\s*[–—-]\s*/i, '');
    var loc = e.location || {};
    var where = [txt(loc.addressTitle), (loc.addressLine2 || '').replace(/,?\s*[A-Z]{0,2}\d[\w\s-]*$/, '').trim()].filter(Boolean).join(', ');
    var imgEl = block.querySelector('img');
    var src = (imgEl && (imgEl.getAttribute('data-src') || imgEl.src)) || e.assetUrl || '';
    src = src.split('?')[0];

    var s = sections(exc);
    var status = past ? 'Wrapped' : inStock ? (left <= 10 ? '<strong>Only ' + left + ' spot' + (left === 1 ? '' : 's') + ' left</strong>' : 'Booking now') : 'Sold out';

    var side = '<p class="ggnc-ed-eyebrow">' + esc(eyebrow) + '</p><h1 class="ggnc-ed-title">' + esc(name) + '</h1>' +
      '<dl class="ggnc-ed-facts">' +
      '<div class="ggnc-ed-fact"><dt>Dates</dt><dd>' + esc(range(e)) + '</dd></div>' +
      (where ? '<div class="ggnc-ed-fact"><dt>Where</dt><dd>' + esc(where) + '</dd></div>' : '') +
      (price ? '<div class="ggnc-ed-fact"><dt>Ticket</dt><dd>' + esc(price) + ' per person</dd></div>' : '') +
      '<div class="ggnc-ed-fact"><dt>Status</dt><dd>' + status + '</dd></div></dl>';
    if (!past && inStock && prodUrl) {
      side += '<a class="ggnc-ed-btn" href="' + esc(prodUrl) + '">Book your spot' + (price ? ' — ' + esc(price) : '') + '</a>';
    } else {
      side += '<span class="ggnc-ed-btn is-off">' + (past ? (trip ? 'This trip has wrapped' : 'This event has wrapped') : 'Sold out') + '</span>' +
        '<div class="ggnc-ed-panel"><p class="ggnc-ed-panel-head">' + (past ? (trip ? 'The next Field Trip is being planned.' : 'More Day Passes are on the way.') : 'Hear first if a spot opens up.') + '</p>' +
        '<p class="ggnc-ed-panel-text">Join the list for new Field Trips and Day Passes.</p>' +
        '<form class="ggnc-ed-form" novalidate><input type="email" placeholder="Email address" aria-label="Email address" autocomplete="email" required><button type="submit">Join</button></form>' +
        '<p class="ggnc-ed-msg" role="status" aria-live="polite"></p></div>';
    }

    var main = '';
    if (s.intro.length) {
      var lead = s.days.length || s.intro.length <= 2 ? s.intro : s.intro.slice(0, 1);
      var rest = lead === s.intro ? [] : s.intro.slice(1);
      main += '<div class="ggnc-ed-sec ggnc-ed-intro" style="margin-top:32px">' + lead.map(function (t) { return '<p>' + esc(t) + '</p>'; }).join('') + '</div>';
      if (rest.length) main += '<div class="ggnc-ed-sec"><h2 class="ggnc-ed-h">' + (trip ? 'The trip' : 'The day') + '</h2>' + rest.map(function (t) { return '<p>' + esc(t) + '</p>'; }).join('') + '</div>';
    }
    if (s.days.length) main += '<div class="ggnc-ed-sec"><h2 class="ggnc-ed-h">The itinerary</h2>' + s.days.map(function (d) {
      return '<div class="ggnc-ed-day"><div class="ggnc-ed-day-label">' + esc(d.label) + (d.note ? '<small>' + esc(d.note) + '</small>' : '') + '</div><div>' +
        d.ps.map(function (t) { return '<p>' + esc(t) + '</p>'; }).join('') + '</div></div>';
    }).join('') + '</div>';
    s.lists.forEach(function (l) {
      if (!l.items.length && !l.ps.length) return;
      main += '<div class="ggnc-ed-sec"><h2 class="ggnc-ed-h">' + esc(l.title) + '</h2>' +
        (l.items.length ? '<ul class="ggnc-ed-list' + (l.items.length < 6 ? ' is-single' : '') + '">' + l.items.map(function (t) { return '<li>' + esc(t) + '</li>'; }).join('') + '</ul>' : '') +
        l.ps.map(function (t) { return '<p>' + esc(t) + '</p>'; }).join('') + '</div>';
    });
    s.other.forEach(function (o) {
      if (!o.ps.length) { main += '<p style="margin-top:28px"><strong style="font-weight:500">' + esc(o.title) + '</strong></p>'; return; }
      main += '<div class="ggnc-ed-sec"><h2 class="ggnc-ed-h">' + esc(o.title) + '</h2>' + o.ps.map(function (t) {
        return typeof t === 'object'
          ? '<div class="ggnc-ed-day"><div class="ggnc-ed-day-label">' + esc(t.label) + '</div><div><p>' + esc(t.text) + '</p></div></div>'
          : '<p>' + esc(t) + '</p>';
      }).join('') + '</div>';
    });

    var html = '<div class="ggnc-ed"><a class="ggnc-ed-back" href="/events">← All events</a><div class="ggnc-ed-grid">' +
      (src ? '<div class="ggnc-ed-poster ggnc-ed-main-img"><img src="' + esc(src) + '?format=1500w" alt="' + esc(name) + '"></div>' : '') +
      '<aside class="ggnc-ed-side">' + side + '</aside>' +
      '<div class="ggnc-ed-main">' + main + '</div></div></div>';

    art.insertAdjacentHTML('beforebegin', html);
    var wrap = document.querySelector('.ggnc-ed');
    // desktop: poster sits at the top of the left column
    var poster = wrap.querySelector('.ggnc-ed-poster'), mainCol = wrap.querySelector('.ggnc-ed-main');
    if (poster && window.matchMedia('(min-width: 1024px)').matches) mainCol.insertBefore(poster, mainCol.firstChild);
    document.body.classList.add('ggnc-ed-on');
    var panel = wrap.querySelector('.ggnc-ed-panel');
    if (panel) signup(panel);
  }

  // Event pages without a ticket (photo + text + RSVP button / gallery)
  function nativeTime(art) {
    var t = art.querySelector('.eventitem-meta-time .event-time-localized-start, .eventitem-meta-time time, .event-time-12hr-start');
    return t ? t.textContent.replace(/\s+/g, ' ').trim() : '';
  }
  function buildPlain() {
    var art = document.querySelector('article.eventitem');
    if (!art || document.querySelector('.ggnc-ed')) return;
    var content = art.querySelector('.eventitem-column-content') || art;
    fetch(location.pathname + '?format=json', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (ev) {
      if (document.querySelector('.ggnc-ed')) return;
      var e = ev.item, trip = /field trip/i.test(e.title);
      var past = new Date(e.endDate || e.startDate) < new Date();
      var multi = (new Date(e.endDate || e.startDate) - new Date(e.startDate)) > 20 * 3600 * 1000;
      var name = txt(e.title).replace(/^\s*(ggnc\s+)?field trip\s*(\d+)?\s*[–—-]\s*/i, '');
      var loc = e.location || {};
      var where = [txt(loc.addressTitle), (loc.addressLine2 || '').replace(/,?\s*[A-Z]{0,2}\d[\w\s-]*$/, '').trim()].filter(Boolean).join(', ');
      var blocks = [].slice.call(content.querySelectorAll('.sqs-block'));
      var imgBlock = blocks.filter(function (b) { return b.classList.contains('sqs-block-image'); })[0];
      var btnBlock = blocks.filter(function (b) { return b.classList.contains('sqs-block-button'); })[0];
      var btnA = btnBlock && btnBlock.querySelector('a');
      var imgEl = imgBlock && imgBlock.querySelector('img');
      var src = ((imgEl && (imgEl.getAttribute('data-src') || imgEl.src)) || e.assetUrl || '').split('?')[0];
      var time = multi ? '' : nativeTime(art);

      var side = '<p class="ggnc-ed-eyebrow">' + (trip ? 'Field Trip' : 'Day Pass') + '</p><h1 class="ggnc-ed-title">' + esc(name) + '</h1>' +
        '<dl class="ggnc-ed-facts"><div class="ggnc-ed-fact"><dt>' + (multi ? 'Dates' : 'Date') + '</dt><dd>' + esc(range(e)) + (time ? ', ' + esc(time) : '') + '</dd></div>' +
        (where ? '<div class="ggnc-ed-fact"><dt>Where</dt><dd>' + esc(where) + '</dd></div>' : '') +
        '<div class="ggnc-ed-fact"><dt>Status</dt><dd>' + (past ? 'Wrapped' : 'Upcoming') + '</dd></div></dl>';
      if (!past && btnA) {
        side += '<a class="ggnc-ed-btn" href="' + esc(btnA.href) + '"' + (btnA.target ? ' target="' + esc(btnA.target) + '" rel="noopener"' : '') + '>' + esc(btnA.textContent.trim() || 'RSVP') + '</a>';
      } else if (past) {
        side += '<span class="ggnc-ed-btn is-off">' + (trip ? 'This trip has wrapped' : 'This event has wrapped') + '</span>' +
          '<div class="ggnc-ed-panel"><p class="ggnc-ed-panel-head">' + (trip ? 'The next Field Trip is being planned.' : 'More Day Passes are on the way.') + '</p>' +
          '<p class="ggnc-ed-panel-text">Join the list for new Field Trips and Day Passes.</p>' +
          '<form class="ggnc-ed-form" novalidate><input type="email" placeholder="Email address" aria-label="Email address" autocomplete="email" required><button type="submit">Join</button></form>' +
          '<p class="ggnc-ed-msg" role="status" aria-live="polite"></p></div>';
      }

      var html = '<div class="ggnc-ed ggnc-ed-plain"><div class="ggnc-ed-grid">' +
        (src ? '<div class="ggnc-ed-poster"><img src="' + esc(src) + '?format=1500w" alt="' + esc(name) + '"></div>' : '') +
        '<aside class="ggnc-ed-side">' + side + '</aside><div class="ggnc-ed-main"></div></div></div>';
      art.insertAdjacentHTML('beforebegin', html);
      var wrap = document.querySelector('.ggnc-ed'), mainCol = wrap.querySelector('.ggnc-ed-main');
      var first = true;
      blocks.forEach(function (b) {
        if (b === imgBlock || b === btnBlock) return;
        if (!b.textContent.trim() && !b.querySelector('img, iframe, video')) return;
        var sec = document.createElement('div');
        sec.className = 'ggnc-ed-sec ggnc-ed-native' + (first ? ' ggnc-ed-intro' : '');
        if (first) sec.style.marginTop = '32px';
        sec.appendChild(b);
        mainCol.appendChild(sec);
        first = false;
      });
      var poster = wrap.querySelector('.ggnc-ed-poster');
      if (poster && window.matchMedia('(min-width: 1024px)').matches) mainCol.insertBefore(poster, mainCol.firstChild);
      document.body.classList.add('ggnc-ed-on');
      var panel = wrap.querySelector('.ggnc-ed-panel');
      if (panel) signup(panel);
      // let moved galleries / lazy images re-measure
      setTimeout(function () {
        window.dispatchEvent(new Event('resize'));
        [].slice.call(mainCol.querySelectorAll('img[data-src]')).forEach(function (i) { if (!i.getAttribute('src')) i.src = i.getAttribute('data-src') + '?format=1000w'; });
      }, 60);
    }).catch(function () {});
  }

  function start() {
    var block = document.querySelector('article.eventitem .product-block');
    if (!block) { buildPlain(); return; } // pages without a ticket get the simpler version
    var a = block.querySelector('a[href*="/p/"]');
    var prodPath = a ? new URL(a.href, location.href).pathname : null;
    Promise.all([
      fetch(location.pathname + '?format=json', { credentials: 'same-origin' }).then(function (r) { return r.json(); }),
      prodPath ? fetch(prodPath + '?format=json', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).catch(function () { return null; }) : null
    ]).then(function (r) { build(r[0], r[1]); }).catch(function () {});
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>

