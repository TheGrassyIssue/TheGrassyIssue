<!-- GGNC: "Shop by Collection" opens its list instead of loading a page (ggnc-collections-menu) -->
<style>
.nested-category-tree-wrapper a.ggnc-coll-toggle { cursor: pointer; }
.nested-category-tree-wrapper a.ggnc-coll-toggle::after { content: "+"; display: inline-block; margin-left: 6px; font-weight: 200; }
.nested-category-tree-wrapper li.ggnc-coll-open > a.ggnc-coll-toggle::after { content: "\2013"; }
.nested-category-tree-wrapper li.ggnc-coll-li > ul { display: none; }
.nested-category-tree-wrapper li.ggnc-coll-open > ul { display: block; }
.nested-category-tree-wrapper li.ggnc-coll-li > ul { padding-left: 14px !important; }
</style>
<script>
(function () {
  var PARENT = '/shop/collections', KEY = 'ggnc-coll-list-v1';
  function norm(h) { try { return new URL(h, location.href).pathname.replace(/\/$/, ''); } catch (e) { return ''; } }
  function onCollections() { return location.pathname.replace(/\/$/, '').indexOf(PARENT) === 0; }

  // The list of collections (read from the sidebar, or fetched once and cached for the visit)
  var listP;
  function getList() {
    if (listP) return listP;
    try { var c = sessionStorage.getItem(KEY); if (c) return (listP = Promise.resolve(JSON.parse(c))); } catch (e) {}
    listP = fetch(PARENT, { credentials: 'same-origin' }).then(function (r) { return r.text(); }).then(function (html) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var out = [];
      doc.querySelectorAll('.nested-category-tree-wrapper a.child, select.product-filter-dropdown-select option').forEach(function (a) {
        var href = norm(a.getAttribute('href') || a.value), name = a.textContent.trim();
        if (href.indexOf(PARENT + '/') === 0 && !out.some(function (x) { return x.href === href; })) out.push({ href: href, name: name });
      });
      try { sessionStorage.setItem(KEY, JSON.stringify(out)); } catch (e) {}
      return out;
    }).catch(function () { return []; });
    return listP;
  }

  // Desktop sidebar
  function setupSidebar() {
    document.querySelectorAll('.nested-category-tree-wrapper a.root').forEach(function (a) {
      if (norm(a.getAttribute('href')) !== PARENT || a.classList.contains('ggnc-coll-toggle')) return;
      var li = a.closest('li');
      a.classList.add('ggnc-coll-toggle');
      a.setAttribute('role', 'button');
      li.classList.add('ggnc-coll-li');
      if (onCollections()) li.classList.add('ggnc-coll-open');
      a.setAttribute('aria-expanded', li.classList.contains('ggnc-coll-open') ? 'true' : 'false');
      if (!li.querySelector('ul')) {
        getList().then(function (list) {
          if (li.querySelector('ul') || !list.length) return;
          var ul = document.createElement('ul');
          ul.innerHTML = list.map(function (x) {
            return '<li><a href="' + x.href + '" class="category-link product-list-category-link child">' + x.name.replace(/</g, '&lt;') + '</a></li>';
          }).join('');
          li.appendChild(ul);
        });
      }
    });
  }

  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('.nested-category-tree-wrapper a.ggnc-coll-toggle');
    if (!a) return;
    e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
    var li = a.closest('li');
    var open = li.classList.toggle('ggnc-coll-open');
    a.setAttribute('aria-expanded', open ? 'true' : 'false');
  }, true);

  // Mobile "Select a Category" drop-down
  function setupSelect() {
    document.querySelectorAll('select.product-filter-dropdown-select').forEach(function (s) {
      if (s.getAttribute('data-ggnc-coll')) return;
      var parent = [].slice.call(s.options).filter(function (o) { return norm(o.value) === PARENT; })[0];
      if (!parent) return;
      s.setAttribute('data-ggnc-coll', '1');
      parent.disabled = true;
      if (onCollections() && location.pathname.replace(/\/$/, '') === PARENT) { s.selectedIndex = 0; }
      getList().then(function (list) {
        var have = [].slice.call(s.options).map(function (o) { return norm(o.value); });
        var after = parent;
        // skip past any children already listed
        while (after.nextElementSibling && norm(after.nextElementSibling.value).indexOf(PARENT + '/') === 0) after = after.nextElementSibling;
        list.forEach(function (x) {
          if (have.indexOf(x.href) !== -1) return;
          var o = document.createElement('option');
          o.value = x.href; o.textContent = x.name;
          after.insertAdjacentElement('afterend', o); after = o;
        });
        // indent the collections under the heading
        [].slice.call(s.options).forEach(function (o) {
          if (norm(o.value).indexOf(PARENT + '/') === 0 && o.textContent.indexOf('—') !== 0) o.textContent = '— ' + o.textContent.trim();
          if (norm(o.value) === location.pathname.replace(/\/$/, '')) o.selected = true;
        });
      });
    });
  }

  function run() { setupSidebar(); setupSelect(); }
  function start() {
    run(); getList();
    var t;
    new MutationObserver(function () { clearTimeout(t); t = setTimeout(run, 100); })
      .observe(document.body, { childList: true, subtree: true });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>

<!-- GGNC: mobile category drop-down - arrow sits right after the category name (ggnc-dropdown-arrow) -->
<style>/* ggnc-arrow-size: 1px chevron to match the search underline */
.product-filter-dropdown-icon svg { display: none !important; }
.product-filter-dropdown-icon { display: flex !important; align-items: center; height: 12px; pointer-events: none; }
.product-filter-dropdown-icon::before { content: ""; display: block; width: 7px; height: 7px; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: translateY(-2px) rotate(45deg); }
</style>
<script>
(function () {
  var canvas = document.createElement('canvas'), ctx = canvas.getContext('2d');
  function place() {
    document.querySelectorAll('.product-filter-dropdown-wrapper').forEach(function (w) {
      var s = w.querySelector('select'), ic = w.querySelector('.dropdown-icon');
      if (!s || !ic || !s.offsetWidth) return;
      var cs = getComputedStyle(s), o = s.options[s.selectedIndex];
      var txt = o ? o.textContent.trim() : '';
      if (cs.textTransform === 'uppercase') txt = txt.toUpperCase();
      ctx.font = cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
      var tw = ctx.measureText(txt).width;
      var x = Math.min(Math.ceil(tw) + parseFloat(cs.paddingLeft || 0) + 10, s.offsetWidth - 18);
      ic.style.right = 'auto';
      ic.style.left = x + 'px';
      ic.style.width = 'auto';
      if (!s.getAttribute('data-ggnc-arrow')) {
        s.setAttribute('data-ggnc-arrow', '1');
        s.addEventListener('change', place);
      }
    });
  }
  function start() {
    place();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(place);
    window.addEventListener('resize', place);
    var t;
    new MutationObserver(function () { clearTimeout(t); t = setTimeout(place, 150); })
      .observe(document.body, { childList: true, subtree: true });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>

