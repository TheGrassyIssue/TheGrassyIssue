  };

  function badge(icon, label) {
    return '<div class="ggnc-badge">' + icon + '<span>' + label + '</span></div>';
  }

  function run() {
    var atc = document.querySelector('.product-meta-section .product-add-to-cart');
    if (!atc || document.querySelector('.ggnc-assurance')) return;

    var box = document.createElement('div');
    box.className = 'ggnc-assurance';
    box.innerHTML =
      '<ul class="ggnc-assurance-list">' +
        '<li>Free US shipping over $150</li>' +
        '<li>Easy returns within 14 days &middot; <a href="/return-policy">Details</a></li>' +
      '</ul>' +
      '<div class="ggnc-badges"></div>';
    atc.insertAdjacentElement('afterend', box);

    // Badges come from product tags: "made-in-nyc" and/or "made-in-usa"
    fetch(location.pathname + '?format=json', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var tags = ((d.item && d.item.tags) || []).map(function (t) {
          return String(t).toLowerCase().trim().replace(/\s+/g, '-');
        });
        var html = '';
        if (tags.indexOf('made-in-nyc') > -1) html += badge(ICONS.nyc, 'Made in New York City');
        if (tags.indexOf('made-in-usa') > -1) html += badge(ICONS.usa, 'Made in the USA');
        box.querySelector('.ggnc-badges').innerHTML = html;
      })
      .catch(function () {});
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();
  window.addEventListener('mercury:load', run);
})();
</script>








<!-- GGNC: Sold Out label on shop images -->
<style>
  .product-list-item.ggnc-sold-out .product-list-image-wrapper::after {
    content: "Sold Out";
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    padding: 5px 8px;
    background: #000;
    color: #fff;
    font-family: degular-text, sans-serif;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .product-list-item.ggnc-sold-out .product-list-item-status {
    display: none !important;
  }
</style>
<script>
(function () {
  function mark() {
    document.querySelectorAll('.product-list-item').forEach(function (item) {
      var status = item.querySelector('.product-list-item-status');
      var soldOut = status && /sold out/i.test(status.textContent);
      item.classList.toggle('ggnc-sold-out', !!soldOut);
    });
  }
  function start() {
    mark();
    var list = document.querySelector('.product-list');
    if (list) new MutationObserver(mark).observe(list, { childList: true, subtree: true });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>
<!-- GGNC: shop toolbar - category nav + live search (mobile and desktop) -->
<style>
/* ---------- Mobile: dropdown + search on one slim line ---------- */
@media (max-width: 767px) {
  body .product-list .product-list-header .nested-category-title,
  body .product-list .product-filter-label { display: none !important; }

  body .product-list .product-list-category-select-container {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 6px 0 !important;
    margin-bottom: 12px;
    border-bottom: 1px solid #e5e5e5;
  }
  body .product-list .product-list-category-select-container .field-list,
  body .product-list .product-filter-dropdown-container,
  body .product-list .product-filter-dropdown-fieldset {
    margin: 0 !important;
    padding: 0 !important;
    flex: 0 1 auto;
    min-width: 0;
  }
  body .product-list .product-filter-dropdown-select {
    border: 0 !important;
    background-color: transparent !important;
    padding: 0 28px 0 0 !important;
    font-size: 15px !important;
    color: #000 !important;
  }
  .ggnc-shop-search--desktop { display: none !important; }
  .ggnc-shop-search--mobile { flex: 0 1 150px; }
}

/* ---------- Desktop: search + category list in the sidebar ---------- */
@media (min-width: 768px) {
  .ggnc-shop-search--mobile { display: none !important; }
  body .product-list .product-list-category-subnav-container { grid-row: 3 / 7 !important; align-self: stretch !important; }
  body .product-list .product-list-category-subnav-container .product-list-nav {
    position: sticky;
    top: 24px;
  }
  .ggnc-shop-search--desktop { width: 100%; margin: 0 0 28px; }
  body .product-list .nested-category-tree-wrapper ul { margin: 0; padding: 0; list-style: none; }
  body .product-list .nested-category-tree-wrapper li { margin: 0 !important; padding: 0 !important; }
  body .product-list .product-list-category-link {
    display: inline-block;
    padding: 5px 0 !important;
    font-size: 14px !important;
    line-height: 1.4 !important;
    color: #666 !important;
    text-decoration: none !important;
  }
  body .product-list .product-list-category-link:hover { color: #000 !important; }
  body .product-list .product-list-category-link.active {
    color: #000 !important;
    text-decoration: underline !important;
    text-underline-offset: 4px;
  }
}

/* ---------- Search field (shared) ---------- */
.ggnc-shop-search { display: flex; align-items: center; gap: 6px; margin: 0; border-bottom: 1px solid #000; }
.ggnc-shop-search input { width: 100%; min-width: 0; padding: 6px 0 !important; border: 0 !important; border-radius: 0; background: transparent !important; font: inherit; font-size: 16px; color: #000; outline: none; -webkit-appearance: none; }
.ggnc-shop-search input::placeholder { color: #777; }
.ggnc-shop-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
.ggnc-shop-search button { display: flex; padding: 0; margin: 0; border: 0; background: none; color: #000; cursor: pointer; }
.ggnc-shop-search svg { width: 16px; height: 16px; }

/* ---------- Search results ---------- */
.product-list-item.ggnc-hide,
.product-list-item.ggnc-extra:not(.ggnc-match) { display: none !important; }
body.ggnc-searching .list-pagination { display: none !important; }
.ggnc-no-results { grid-column: 1 / -1; padding: 40px 0; text-align: center; color: #555; }
</style>
<script>
(function () {
  var ICON_SEARCH = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>';
  var ICON_CLEAR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6L18 18M18 6L6 18"/></svg>';
  var extrasLoaded = false;

  function norm(s) { return String(s || '').toLowerCase().replace(/[-_]/g, ' '); }

  function itemText(item) {
    var t = item.querySelector('.product-list-item-title');
    var tags = [].filter.call(item.classList, function (c) { return c.indexOf('tag-') === 0; }).join(' ');
    return norm((t ? t.textContent : '') + ' ' + tags);
  }

  function money(v) { return '$' + Number(v).toFixed(2); }

  function buildCard(template, p) {
    var card = template.cloneNode(true);
    card.className = 'product-list-item ggnc-extra ' + (p.tags || []).map(function (t) { return 'tag-' + t; }).join(' ');
    var link = card.querySelector('a');
    link.href = p.fullUrl;
    link.setAttribute('aria-label', p.title);
    var wrap = card.querySelector('.grid-image-wrapper');
    if (wrap) {
      wrap.classList.remove('has-hover-img');
      wrap.innerHTML = '<img class="grid-item-image grid-image-cover" loading="lazy" alt="" src="' + p.assetUrl + '?format=750w">';
    }
    card.querySelectorAll('.preFade').forEach(function (el) { el.classList.remove('preFade'); el.style.opacity = 1; });
    card.querySelector('.product-list-item-title').textContent = p.title;
    var prices = (p.variants || []).map(function (v) { return Number(v.salePriceMoney && v.onSale ? v.salePriceMoney.value : v.priceMoney.value); });
    var min = prices.length ? Math.min.apply(null, prices) : 0;
    var max = prices.length ? Math.max.apply(null, prices) : 0;
    card.querySelector('.product-list-item-price').textContent = (min !== max ? 'from ' : '') + money(min);
    var soldOut = (p.variants || []).length && p.variants.every(function (v) { return !v.unlimited && v.qtyInStock <= 0; });
    var status = card.querySelector('.product-list-item-status');
    if (status) status.innerHTML = soldOut ? '<div class="grid-meta-status"><div>Sold Out</div></div>' : '';
    return card;
  }

  function loadExtras(grid) {
    if (extrasLoaded) return Promise.resolve();
    extrasLoaded = true;
    var template = grid.querySelector('.product-list-item');
    if (!template) return Promise.resolve();
    var have = {};
    grid.querySelectorAll('.product-list-item a[href]').forEach(function (a) { have[a.getAttribute('href')] = 1; });
    var base = location.pathname;
    function page(offset) {
      var url = base + '?format=json' + (offset ? '&offset=' + offset : '');
      return fetch(url, { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (d) {
        (d.items || []).forEach(function (p) {
          if (p.fullUrl && !have[p.fullUrl]) { have[p.fullUrl] = 1; grid.appendChild(buildCard(template, p)); }
        });
        if (d.pagination && d.pagination.nextPage) return page(d.pagination.nextPageOffset);
      });
    }
    return page(0).catch(function () {});
  }

  function filter(grid, q) {
    var words = norm(q).trim().split(/\s+/).filter(Boolean);
    var shown = 0;
    grid.querySelectorAll('.product-list-item').forEach(function (item) {
      var txt = itemText(item);
      var ok = words.every(function (w) { return txt.indexOf(w) > -1; });
      var extra = item.classList.contains('ggnc-extra');
      item.classList.toggle('ggnc-hide', !extra && words.length > 0 && !ok);
      item.classList.toggle('ggnc-match', extra && words.length > 0 && ok);
      if ((words.length === 0 && !extra) || (words.length > 0 && ok)) shown++;
    });
    document.body.classList.toggle('ggnc-searching', words.length > 0);
    var msg = grid.querySelector('.ggnc-no-results');
    if (!msg) { msg = document.createElement('div'); msg.className = 'ggnc-no-results'; grid.appendChild(msg); }
    msg.textContent = shown ? '' : 'No products found for “' + q.trim() + '”';
    msg.style.display = shown ? 'none' : '';
  }

  function makeForm(variant) {
    var form = document.createElement('form');
    form.className = 'ggnc-shop-search ggnc-shop-search--' + variant;
    form.setAttribute('role', 'search');
    form.innerHTML = '<input type="search" placeholder="Search" aria-label="Search products" autocomplete="off">' +
      '<button type="button" aria-label="Search">' + ICON_SEARCH + '</button>';
    return form;
  }

  function addShopAll() {
    var list = document.querySelector('.product-list-category-subnav-container .nested-category-tree-wrapper ul');
    var first = list && list.querySelector('.product-list-category-link');
    if (!list || !first || list.querySelector('.ggnc-shop-all')) return;
    var shopRoot = '/' + location.pathname.split('/')[1];
    var li = document.createElement('li');
    li.className = 'category-item';
    li.innerHTML = '<a class="category-link product-list-category-link root ggnc-shop-all" href="' + shopRoot + '">Shop All</a>';
    if (location.pathname.replace(/\/$/, '') === shopRoot) li.firstChild.classList.add('active');
    list.insertBefore(li, list.firstChild);
  }

  function setup() {
    var grid = document.querySelector('.product-list-layout-container');
    if (!grid || document.querySelector('.ggnc-shop-search')) return;

    var forms = [];
    var bar = document.querySelector('.product-list-category-select-container');
    if (bar) { var m = makeForm('mobile'); bar.appendChild(m); forms.push(m); }
    var nav = document.querySelector('.product-list-category-subnav-container .product-list-nav');
    if (nav) { var dsk = makeForm('desktop'); nav.insertBefore(dsk, nav.firstChild); forms.push(dsk); }
    addShopAll();

    var timer;
    function run(source) {
      var q = source.value;
      forms.forEach(function (f) {
        var inp = f.querySelector('input'), b = f.querySelector('button');
        if (inp !== source) inp.value = q;
        b.innerHTML = q ? ICON_CLEAR : ICON_SEARCH;
        b.setAttribute('aria-label', q ? 'Clear search' : 'Search');
      });
      if (q.trim()) loadExtras(grid).then(function () { filter(grid, source.value); });
      filter(grid, q);
    }

    forms.forEach(function (form) {
      var input = form.querySelector('input');
      var btn = form.querySelector('button');
      input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(function () { run(input); }, 150); });
      form.addEventListener('submit', function (e) { e.preventDefault(); input.blur(); run(input); });
      btn.addEventListener('click', function () {
        if (input.value) { input.value = ''; run(input); }
        input.focus();
      });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
  else setup();
})();
</script>
<!-- GGNC: desktop gallery - trackpad swipe, click-drag and arrow keys -->
<script>
(function () {
  function init() {
    var g = document.querySelector('.pdp-gallery-wrapper');
    if (!g || g.getAttribute('data-ggnc-swipe')) return;
    g.setAttribute('data-ggnc-swipe', '1');
    var next = g.querySelector('[data-product-gallery="next"]');
    var prev = g.querySelector('[data-product-gallery="prev"]');
    var locked = false, acc = 0, quiet;

    function go(dir) {
      var b = dir > 0 ? next : prev;
      if (!b || b.disabled) return;
      b.click();
    }

    // Two-finger trackpad swipe / horizontal wheel: one slide per gesture
    g.addEventListener('wheel', function (e) {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault();
      clearTimeout(quiet);
      quiet = setTimeout(function () { locked = false; acc = 0; }, 250);
      if (locked) return;
      acc += e.deltaX;
      if (Math.abs(acc) > 40) { locked = true; go(acc); }
    }, { passive: false });

    // Click and drag with the mouse
    var startX = null, dragged = false;
    g.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || e.button !== 0 || e.target.closest('button')) return;
      startX = e.clientX; dragged = false;
    });
    window.addEventListener('pointerup', function (e) {
      if (startX === null) return;
      var dx = e.clientX - startX; startX = null;
      if (Math.abs(dx) > 50) {
        dragged = true;
        var dir = dx < 0 ? 1 : -1;
        setTimeout(function () { dragged = false; go(dir); }, 50); // after the stray click is swallowed
      }
    });
    g.addEventListener('click', function (e) {
      if (dragged) { e.preventDefault(); e.stopPropagation(); dragged = false; }
    }, true);
    g.addEventListener('dragstart', function (e) { e.preventDefault(); });

    // Left / right arrow keys
    document.addEventListener('keydown', function (e) {
      var t = document.activeElement && document.activeElement.tagName;
      if (/INPUT|TEXTAREA|SELECT/.test(t) || e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === 'ArrowRight') go(1);
      else if (e.key === 'ArrowLeft') go(-1);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  window.addEventListener('load', init);
})();
</script>
<!-- GGNC: desktop product gallery - click a photo to open it full screen -->
<style>
@media (min-width: 768px) {
  .pdp-gallery .pdp-carousel-controls { cursor: zoom-in; }
  .pdp-gallery .pdp-carousel-controls button { cursor: pointer; }
}
.ggnc-lb { position: fixed; inset: 0; z-index: 99999; background: #fff; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .2s ease; }
.ggnc-lb.is-open { opacity: 1; }
.ggnc-lb img { max-width: calc(100vw - 180px); max-height: calc(100vh - 100px); width: auto; height: auto; object-fit: contain; display: block; cursor: zoom-out; user-select: none; }
.ggnc-lb button { position: absolute; background: none; border: 0; padding: 16px; margin: 0; cursor: pointer; color: #000; line-height: 0; }
.ggnc-lb button[disabled] { opacity: .2; cursor: default; }
.ggnc-lb svg { width: 26px; height: 26px; }
.ggnc-lb-close { top: 14px; right: 18px; }
.ggnc-lb-prev { left: 18px; top: 50%; transform: translateY(-50%); }
.ggnc-lb-next { right: 18px; top: 50%; transform: translateY(-50%); }
.ggnc-lb-count { position: absolute; bottom: 22px; left: 0; right: 0; text-align: center; font-family: "Martian Mono", monospace; font-size: 10.5px; letter-spacing: .08em; color: #555; }
html.ggnc-lb-lock, html.ggnc-lb-lock body { overflow: hidden !important; }
</style>
<script>
(function () {
  var CLOSE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5 5L19 19M19 5L5 19"/></svg>';
  var PREV = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M15 4L7 12L15 20"/></svg>';
  var NEXT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M9 4L17 12L9 20"/></svg>';

  function bigSrc(img) {
    var s = img.getAttribute('data-src') || img.getAttribute('data-image') || img.currentSrc || img.src || '';
    return s.split('?')[0] + '?format=2500w';
  }

  function init() {
    var gal = document.querySelector('.pdp-gallery');
    var ctr = gal && gal.querySelector('.pdp-carousel-controls');
    if (!ctr || ctr.getAttribute('data-ggnc-lb')) return;
    ctr.setAttribute('data-ggnc-lb', '1');

    var slides = [].slice.call(gal.querySelectorAll('.pdp-gallery-slides'));
    var srcs = slides.map(function (s) { var i = s.querySelector('img'); return i ? bigSrc(i) : ''; });
    var box, img, prevB, nextB, count, idx = 0;

    function show(i) {
      idx = Math.max(0, Math.min(srcs.length - 1, i));
      img.src = srcs[idx];
      prevB.disabled = idx === 0;
      nextB.disabled = idx === srcs.length - 1;
      count.textContent = (idx + 1) + ' / ' + srcs.length;
      // preload neighbours
      [idx - 1, idx + 1].forEach(function (n) { if (srcs[n]) { var p = new Image(); p.src = srcs[n]; } });
    }

    function open(i) {
      if (!box) build();
      document.documentElement.classList.add('ggnc-lb-lock');
      box.style.display = 'flex';
      show(i);
      requestAnimationFrame(function () { box.classList.add('is-open'); });
    }

    function close() {
      box.classList.remove('is-open');
      document.documentElement.classList.remove('ggnc-lb-lock');
      setTimeout(function () { box.style.display = 'none'; }, 200);
    }

    function build() {
      box = document.createElement('div');
      box.className = 'ggnc-lb';
      box.setAttribute('role', 'dialog');
      box.setAttribute('aria-modal', 'true');
      box.innerHTML = '<img alt="">' +
        '<button class="ggnc-lb-close" aria-label="Close">' + CLOSE + '</button>' +
        '<button class="ggnc-lb-prev" aria-label="Previous image">' + PREV + '</button>' +
        '<button class="ggnc-lb-next" aria-label="Next image">' + NEXT + '</button>' +
        '<div class="ggnc-lb-count"></div>';
      document.body.appendChild(box);
      img = box.querySelector('img');
      prevB = box.querySelector('.ggnc-lb-prev');
      nextB = box.querySelector('.ggnc-lb-next');
      count = box.querySelector('.ggnc-lb-count');
      box.querySelector('.ggnc-lb-close').addEventListener('click', close);
      prevB.addEventListener('click', function (e) { e.stopPropagation(); show(idx - 1); });
      nextB.addEventListener('click', function (e) { e.stopPropagation(); show(idx + 1); });
      box.addEventListener('click', function (e) { if (e.target === box || e.target === img) close(); });

      // Trackpad swipe inside the lightbox
      var locked = false, acc = 0, quiet;
      box.addEventListener('wheel', function (e) {
        e.preventDefault();
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        clearTimeout(quiet);
        quiet = setTimeout(function () { locked = false; acc = 0; }, 250);
        if (locked) return;
        acc += e.deltaX;
        if (Math.abs(acc) > 40) { locked = true; show(idx + (acc > 0 ? 1 : -1)); }
      }, { passive: false });

      // Keys while open (captured so the page gallery doesn't also move)
      window.addEventListener('keydown', function (e) {
        if (!box.classList.contains('is-open')) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(idx + 1);
        else if (e.key === 'ArrowLeft') show(idx - 1);
        else return;
        e.preventDefault(); e.stopPropagation();
      }, true);
    }

    // A plain click on a photo (not an arrow, not a drag) opens it
    var downX = null;
    ctr.addEventListener('pointerdown', function (e) { downX = e.clientX; });
    ctr.addEventListener('click', function (e) {
      if (window.innerWidth < 768 || e.target.closest('button')) return;
      if (downX !== null && Math.abs(e.clientX - downX) > 8) return;
      for (var i = 0; i < slides.length; i++) {
        var r = slides[i].getBoundingClientRect();
        if (e.clientX >= r.left && e.clientX < r.right && e.clientY >= r.top && e.clientY < r.bottom) { open(i); return; }
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  window.addEventListener('load', init);
})();
</script>
<!-- GGNC: colour swatches under the price on shop + New Arrivals cards -->
<style>
.ggnc-swatches { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; margin-top: 7px; line-height: 1; }
.ggnc-swatches-label { font-family: "Martian Mono", monospace; font-weight: 200; font-size: 9px; letter-spacing: .06em; text-transform: uppercase; color: #8a8a8a; margin-right: 3px; }
.ggnc-sw { position: relative; display: inline-block; width: 10px; height: 10px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.18); }
.ggnc-sw.is-out { opacity: .35; }
.ggnc-sw.is-out::after { content: ""; position: absolute; left: -1px; right: -1px; top: 50%; border-top: 1px solid #000; transform: rotate(-45deg); }
@media (max-width: 767px) { .ggnc-swatches { margin-top: 6px; gap: 4px; } .ggnc-sw { width: 9px; height: 9px; } }
</style>
<script>
(function () {
  // Colour names (as typed in the product's "Color" option) -> swatch colour.
  // Add or tweak a line here to change a swatch. Names are matched lowercase.
  var COLORS = {
    'black': '#111111', 'vintage black': '#2e2d2b',
    'white': '#ffffff', 'off white': '#f2efe6', 'off-white': '#f2efe6', 'warm white': '#f4eee1',
    'cream': '#ece2cc', 'natural': '#e6dcc6', 'sand': '#d8c8a6', 'sandstone': '#c9b391', 'khaki': '#b5a37c',
    'brown': '#6a4a33', 'dirt': '#7a6248', 'camo': '#6b6a4a',
    'olive': '#5e6240', 'dark sage': '#6d7862', 'sage': '#9ba68d', 'green': '#3f6b45', 'emerald green': '#1f6b4f',
    'navy': '#1f2a44', 'navy blue': '#1f2a44', 'vintage navy': '#3a4560',
    'light blue': '#a9c4dc', 'blue': '#2f5d9a', 'ocean': '#7c8e9a',
    'grey': '#8a8a8a', 'gray': '#8a8a8a', 'dark gray': '#4a4a4a', 'dark grey': '#4a4a4a', 'two-tone grey': '#8a8a8a',
    'pink': '#f0b9c4', 'baby pink': '#f6d3db', 'dusty pink': '#d8a6a7', 'magenta': '#b5306e',
    'red': '#b3262b', 'red algae': '#5c2328', 'rust': '#a4502a', 'burnt orange': '#bf5a24',
    'orange': '#e07b2a', 'negroni': '#d4552a', 'negroni orange': '#d4552a',
    'mustard': '#d1a128', 'yellow': '#e9cf3b', 'gold': '#c9a648'
  };

  function hexFor(name) {
    var n = String(name).toLowerCase().trim();
    var paren = n.match(/\(([^)]+)\)/);              // "LL Bean Canvas (Olive)" -> olive
    if (paren) n = paren[1].trim();
    n = n.replace(/\s+only$/, '');
    if (COLORS[n]) return [COLORS[n]];
    var parts = n.split(/\s*(?:\/|\bwith\b|\bw\/)\s*/).filter(Boolean);   // "Black/White", "White w/ Olive"
    if (parts.length === 2 && COLORS[parts[0]] && COLORS[parts[1]]) return [COLORS[parts[0]], COLORS[parts[1]]];
    return null;
  }

  function swatchesFor(p) {
    var seen = {}, list = [];
    (p.variants || []).forEach(function (v) {
      var c = v.attributes && v.attributes.Color;
      if (!c) return;
      c = c.trim();
      var inStock = v.unlimited || v.qtyInStock > 0;
      if (seen[c]) { seen[c].inStock = seen[c].inStock || inStock; return; }
      seen[c] = { name: c, inStock: inStock, hex: hexFor(c) };
      list.push(seen[c]);
    });
    if (list.length < 2 || list.some(function (s) { return !s.hex; })) return null;
    return list;
  }

  function render(list) {
    var el = document.createElement('div');
    el.className = 'ggnc-swatches';
    el.setAttribute('aria-label', list.length + ' colours: ' + list.map(function (s) { return s.name; }).join(', '));
    var html = '<span class="ggnc-swatches-label">Colors</span>';
    list.forEach(function (s) {
      var bg = s.hex.length === 2 ? 'linear-gradient(135deg,' + s.hex[0] + ' 50%,' + s.hex[1] + ' 50%)' : s.hex[0];
      html += '<i class="ggnc-sw' + (s.inStock ? '' : ' is-out') + '" title="' + s.name.replace(/"/g, '') + (s.inStock ? '' : ' (sold out)') + '" style="background:' + bg + '"></i>';
    });
    el.innerHTML = html;
    return el;
  }

  // Load every product once (cached for the visit)
  var KEY = 'ggnc-swatch-data-v1', dataP;
  function loadData() {
    if (dataP) return dataP;
    try { var c = sessionStorage.getItem(KEY); if (c) return (dataP = Promise.resolve(JSON.parse(c))); } catch (e) {}
    var map = {};
    function page(offset) {
      return fetch('/shop?format=json' + (offset ? '&offset=' + offset : ''), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          (d.items || []).forEach(function (p) { var s = swatchesFor(p); if (s) map[p.fullUrl] = s; });
          if (d.pagination && d.pagination.nextPage) return page(d.pagination.nextPageOffset);
        });
    }
    dataP = page(0).then(function () {
      try { sessionStorage.setItem(KEY, JSON.stringify(map)); } catch (e) {}
      return map;
    }).catch(function () { return {}; });
    return dataP;
  }

  function path(a) { try { return new URL(a.href, location.href).pathname; } catch (e) { return ''; } }

  function apply() {
    var cards = [];
    function add(card, after) {
      var a = card.querySelector('a[href*="/p/"]');
      if (!a || !after) return;
      var url = path(a);
      if (card.getAttribute('data-ggnc-sw') === url) return;   // already done for this product
      cards.push({ card: card, url: url, after: after });
    }
    document.querySelectorAll('.product-list-item').forEach(function (card) {
      add(card, card.querySelector('.product-list-item-price'));
    });
    document.querySelectorAll('.summary-item').forEach(function (card) {
      var pr = card.querySelector('.product-price');
      add(card, pr ? (pr.closest('.summary-metadata-container') || pr) : card.querySelector('.summary-metadata-container'));
    });
    if (!cards.length) return;
    loadData().then(function (map) {
      cards.forEach(function (c) {
        if (c.card.getAttribute('data-ggnc-sw') === c.url) return;
        c.card.setAttribute('data-ggnc-sw', c.url);
        var old = c.card.querySelector('.ggnc-swatches');   // copied cards (search results) may carry another product's
        if (old) old.remove();
        var list = map[c.url];
        if (list) c.after.insertAdjacentElement('afterend', render(list));
      });
    });
  }

  function start() {
    apply();
    var t;
    new MutationObserver(function () { clearTimeout(t); t = setTimeout(apply, 120); })
      .observe(document.body, { childList: true, subtree: true });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>
<!-- GGNC: desktop product page grid - load every gallery photo (ggnc-pdp-loadall) -->
<script>
(function () {
