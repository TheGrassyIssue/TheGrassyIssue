<script>
(function () {
  if (location.pathname.replace(/\/$/, '') !== '/events') return;

  var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
  function txt(html) { var d = document.createElement('div'); d.innerHTML = html || ''; return (d.textContent || '').trim(); }
  function isTrip(e) { return /field trip/i.test(e.title || ''); }
  function tripName(t) { return t.replace(/^\s*(ggnc\s+)?field trip\s*(\d+)?\s*[–—-]\s*/i, ''); }
  function place(e) {
    var l = e.location || {};
    var city = (l.addressLine2 || '').replace(/,?\s*[A-Z]{0,2}\d[\w\s-]*$/, '').trim();
    return { venue: txt(l.addressTitle), city: city };
  }
  function range(e) {
    var s = new Date(e.startDate), en = new Date(e.endDate || e.startDate);
    var sd = s.getDate(), sm = MONTHS[s.getMonth()], sy = s.getFullYear();
    var ed = en.getDate(), em = MONTHS[en.getMonth()], ey = en.getFullYear();
    var multi = (en - s) > 20 * 3600 * 1000;
    if (!multi) return sd + ' ' + sm + ' ' + sy;
    if (sm === em && sy === ey) return sd + '–' + ed + ' ' + sm + ' ' + sy;
    if (sy === ey) return sd + ' ' + sm + ' – ' + ed + ' ' + em + ' ' + sy;
    return sd + ' ' + sm + ' ' + sy + ' – ' + ed + ' ' + em + ' ' + ey;
  }
  function short(e) {
    var s = new Date(e.startDate);
    function p(n) { return (n < 10 ? '0' : '') + n; }
    return p(s.getDate()) + '.' + p(s.getMonth() + 1) + '.' + String(s.getFullYear()).slice(2);
  }
  function img(e) {
    if (!e.assetUrl) return '';
    var fp = e.mediaFocalPoint || { x: .5, y: .5 };
    return '<img src="' + esc(e.assetUrl) + '?format=1000w" alt="' + esc(e.title) + '" loading="lazy" style="object-position:' + (fp.x * 100) + '% ' + (fp.y * 100) + '%">';
  }
  function card(e, upcoming) {
    var p = place(e);
    var tag = upcoming ? '<span class="ggnc-ev-tag">' + (isTrip(e) ? 'Booking now' : 'Upcoming') + '</span>' : '<span class="ggnc-ev-tag is-past">Past trip</span>';
    var name = isTrip(e) ? tripName(e.title) : e.title;
    return '<a class="ggnc-ev-card" href="' + esc(e.fullUrl) + '">' +
      '<div class="ggnc-ev-img">' + img(e) + tag + '</div>' +
      '<p class="ggnc-ev-title">' + esc(name) + '</p>' +
      '<p class="ggnc-ev-meta">' + esc(range(e)) + (p.city ? '<br>' + esc(p.city) : '') + '</p></a>';
  }
  function row(e, upcoming) {
    var p = place(e);
    var where = [p.venue, p.city].filter(Boolean).join(', ');
    return '<li><a class="ggnc-ev-row" href="' + esc(e.fullUrl) + '">' +
      '<span class="ggnc-ev-row-date">' + esc(short(e)) + '</span>' +
      '<span class="ggnc-ev-row-title">' + esc(e.title) + (upcoming ? '<span class="ggnc-ev-soon">Upcoming</span>' : '') + '</span>' +
      '<span class="ggnc-ev-row-place">' + esc(where) + '</span>' +
      '<span class="ggnc-ev-row-arrow">→</span></a></li>';
  }

  function signup(panel) {
    var form = panel.querySelector('form'), input = form.querySelector('input'), btn = form.querySelector('button'), msg = panel.querySelector('.ggnc-ev-msg');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent = 'Please enter a valid email address.'; return; }
      var ff = document.querySelector('.sqs-block-newsletter form.newsletter-form');
      if (!ff) { msg.textContent = 'Sign up at the bottom of the page.'; return; }
      var fin = ff.querySelector('input[type=email], input[name=email]');
      var blk = ff.closest('.sqs-block') || ff.parentElement;
      Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(fin, email);
      fin.dispatchEvent(new Event('input', { bubbles: true }));
      fin.dispatchEvent(new Event('change', { bubbles: true }));
      btn.disabled = true; msg.textContent = 'Submitting…';
      var start = Date.now();
      (function watch() {
        var ok = blk.querySelector('.form-submission-text:not(.hidden), .form-submission-html:not(.hidden)');
        if (ok) { panel.classList.add('is-done'); msg.textContent = 'You’re on the list. We’ll be in touch before the next one.'; return; }
        if (Date.now() - start > 9000) { btn.disabled = false; msg.textContent = 'Something went wrong. Please try again.'; return; }
        setTimeout(watch, 250);
      })();
      if (ff.requestSubmit) ff.requestSubmit(); else (ff.querySelector('button, [type=submit]') || {}).click();
    });
  }

  function build(d) {
    var list = document.querySelector('.sqs-events-collection-list');
    if (!list || list.querySelector('.ggnc-ev')) return;
    [].concat(d.upcoming || [], d.past || []).forEach(function (e) { e.title = txt(e.title); });
    var up = (d.upcoming || []).slice().sort(function (a, b) { return a.startDate - b.startDate; });
    var past = (d.past || []).slice().sort(function (a, b) { return b.startDate - a.startDate; });
    var tripsUp = up.filter(isTrip), tripsPast = past.filter(isTrip);
    var daysUp = up.filter(function (e) { return !isTrip(e); }), daysPast = past.filter(function (e) { return !isTrip(e); });

    var html = '<div class="ggnc-ev">';

    html += '<section class="ggnc-ev-sec"><h2 class="ggnc-ev-h">Next up</h2>';
    if (up.length) {
      html += '<div class="ggnc-ev-cards">' + up.slice(0, 3).map(function (e) { return card(e, true); }).join('') + '</div>';
    } else {
      html += '<div class="ggnc-ev-panel"><div><p class="ggnc-ev-panel-head">The next Field Trip is being planned.</p>' +
        '<p class="ggnc-ev-panel-text">Join the list to hear about new Field Trips and Day Passes first. Spots go fast.</p></div>' +
        '<form class="ggnc-ev-form" novalidate><input type="email" placeholder="Email address" aria-label="Email address" autocomplete="email" required><button type="submit">Join</button></form>' +
        '<p class="ggnc-ev-msg" role="status" aria-live="polite"></p></div>';
    }
    html += '</section>';

    if (tripsUp.length || tripsPast.length) {
      html += '<section class="ggnc-ev-sec"><h2 class="ggnc-ev-h">Field Trips<small>Multi-day trips where golf meets the wild</small></h2><div class="ggnc-ev-cards">' +
        tripsUp.map(function (e) { return card(e, true); }).join('') + tripsPast.map(function (e) { return card(e, false); }).join('') + '</div></section>';
    }
    if (daysUp.length || daysPast.length) {
      html += '<section class="ggnc-ev-sec"><h2 class="ggnc-ev-h">Day Passes<small>Walks, dinners, launches and watch parties</small></h2><ul class="ggnc-ev-rows">' +
        daysUp.map(function (e) { return row(e, true); }).join('') + daysPast.map(function (e) { return row(e, false); }).join('') + '</ul></section>';
    }
    html += '</div>';

    list.insertAdjacentHTML('afterbegin', html);
    var h1 = document.querySelector('main h1');
    var intro = h1 && h1.closest('section') && h1.closest('section').querySelector('p');
    if (intro) intro.textContent = 'Field Trips and Day Passes. Golf, nature and good company, in the US and around the world.';
    document.body.classList.add('ggnc-ev-on');
    var panel = list.querySelector('.ggnc-ev-panel');
    if (panel) signup(panel);
  }

  function start() {
    fetch('/events?format=json', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(build)
      .catch(function () {});
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>

