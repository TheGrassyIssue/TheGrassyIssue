    <script>
(function () {

  const THRESHOLD = 150;

  function updateBanner() {

    const summary = document.querySelector('[data-testid="cart-summary-wrapper"]');
    const subtotal = document.querySelector('p[aria-label="Subtotal price"]');

    if (!summary || !subtotal) return;

    let banner = document.querySelector(".ggnc-free-shipping");

    if (!banner) {

      banner = document.createElement("div");

      banner.className = "ggnc-free-shipping";

      banner.innerHTML = `
        <div class="ggnc-free-shipping-label">
          Free Shipping
        </div>

        <div class="ggnc-progress">
          <div class="ggnc-progress-fill"></div>
        </div>

        <div class="ggnc-free-shipping-message"></div>
      `;

      summary.parentNode.insertBefore(banner, summary);

    }

    const total = parseFloat(
      subtotal.textContent.replace(/[^0-9.]/g, "")
    );

    if (isNaN(total)) return;

    const percent = Math.min((total / THRESHOLD) * 100, 100);

    banner.querySelector(".ggnc-progress-fill").style.width =
      percent + "%";

    const message = banner.querySelector(".ggnc-free-shipping-message");

    if (total >= THRESHOLD) {

      message.innerHTML =
   '<strong><span class="ggnc-emoji">🏕️ </span> You\'ve unlocked free shipping.</strong>';

    } else {

      const remaining = (THRESHOLD - total).toFixed(0);

     message.innerHTML =
  "You're <strong>$" +
  remaining +
  "</strong> away from free shipping." +
  '<br><a class="ggnc-continue-shopping" href="/shop">← Keep exploring</a>';
    }

  }

  setInterval(updateBanner, 1000);

})();
  
  function addCarbonMessage() {
  const checkoutButton = document.querySelector('a[aria-label="Checkout"]');

  if (!checkoutButton) return;

  // Prevent duplicates
  if (document.querySelector('.ggnc-carbon-message')) return;

  const message = document.createElement('div');
  message.className = 'ggnc-carbon-message';
  message.innerHTML =
    '🌿 Gumtree Golf & Nature Club contributes <strong>2%</strong> of your purchase to help remove CO₂ from the atmosphere.';

  checkoutButton.insertAdjacentElement('afterend', message);
}

setInterval(addCarbonMessage, 500);
</script>

