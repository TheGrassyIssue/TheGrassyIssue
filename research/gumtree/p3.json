<script>
(function () {
  function footerForm() { return document.querySelector('.sqs-block-newsletter form.newsletter-form'); }

  function isSoldOut(item) {
    var v = item && item.variants;
    return !!(v && v.length && v.every(function (x) { return !x.unlimited && x.qtyInStock <= 0; }));
  }

  function build(anchor) {
    var box = document.createElement('div');
    box.className = 'ggnc-drop';
    box.innerHTML =
      '<p class="ggnc-drop-head">This one’s gone.</p>' +
      '<p class="ggnc-drop-text">Join the drop list to hear about the next release first.</p>' +
      '<form class="ggnc-drop-form" novalidate>' +
        '<input type="email" placeholder="Email address" aria-label="Email address" autocomplete="email" required>' +
        '<button type="submit">Join</button>' +
      '</form>' +
      '<p class="ggnc-drop-msg" role="status" aria-live="polite"></p>';
    anchor.insertAdjacentElement('afterend', box);
    document.body.classList.add('ggnc-soldout-page');

    var form = box.querySelector('form'), input = box.querySelector('input'), btn = box.querySelector('button'), msg = box.querySelector('.ggnc-drop-msg');

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent = 'Please enter a valid email address.'; return; }
      var ff = footerForm();
      if (!ff) { msg.textContent = 'Sign up at the bottom of the page.'; return; }
      var fin = ff.querySelector('input[type=email], input[name=email]');
      var blk = ff.closest('.sqs-block') || ff.parentElement;
      var setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;
      setter.call(fin, email);
      fin.dispatchEvent(new Event('input', { bubbles: true }));
      fin.dispatchEvent(new Event('change', { bubbles: true }));
      btn.disabled = true; msg.textContent = 'Submitting…';

      var start = Date.now();
      (function watch() {
        var ok = blk.querySelector('.form-submission-text:not(.hidden), .form-submission-html:not(.hidden)');
        var err = [].slice.call(blk.querySelectorAll('.field-error, .form-error, [class*=error]')).filter(function (el) { return el.offsetParent !== null && el.textContent.trim(); })[0];
        if (ok) { box.classList.add('is-done'); msg.textContent = 'You’re on the list. We’ll be in touch before the next drop.'; return; }
        if (err && err.textContent.trim() && Date.now() - start > 400) { btn.disabled = false; msg.textContent = err.textContent.trim(); return; }
        if (Date.now() - start > 9000) { btn.disabled = false; msg.textContent = 'Something went wrong. Please try again.'; return; }
        setTimeout(watch, 250);
      })();

      if (ff.requestSubmit) ff.requestSubmit(); else (ff.querySelector('button, [type=submit]') || {}).click();
    });
  }

  function init() {
    var detail = document.querySelector('.product-detail');
    if (!detail || document.querySelector('.ggnc-drop')) return;
    fetch(location.pathname + '?format=json', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!isSoldOut(d.item) || document.querySelector('.ggnc-drop')) return;
        var anchor = detail.querySelector('.product-add-to-cart');
        if (anchor) build(anchor);
      })
      .catch(function () {});
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>

