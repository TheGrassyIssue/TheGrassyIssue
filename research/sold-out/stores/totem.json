{"domain": "totem.golf", "products": [{"id": 10320060350753, "title": "Tag.01 - Magnetic Ball Mark Tag", "handle": "tag-01-magnetic-ball-mark-tag", "body_html": "<p class=\"isSelectedEnd\"><span>Introducing <b>Tag.01 - </b></span><span>TOTEM\u2019s take on the golf bag tag, reimagined as a personal object.</span></p>\n<p class=\"isSelectedEnd\"><span>Precision-machined and built to travel with you, Tag.01 is designed to carry your name, your words, or your symbol \u2014 something that stays with your game. (Free custom engraving)</span></p>\n<p class=\"isSelectedEnd\"><span>At its center, a removable magnetic ball mark sits perfectly in place until you need it. A simple gesture, engineered to feel exact every time.</span></p>\n<p class=\"isSelectedEnd\">Designed to clip seamlessly onto your bag, Tag.01 becomes part of your setup \u2014 not an accessory, but a considered tool.</p>\n<p class=\"isSelectedEnd\"><span>Minimal. Functional. Personal.</span></p>\n<p><span>Limited release : 1st edition Raw brass / Camo pattern</span></p>\n<p><span>EDC box included</span></p>", "published_at": "2026-04-15T14:16:20-04:00", "created_at": "2026-04-15T10:06:59-04:00", "updated_at": "2026-10-21T11:04:37-04:00", "vendor": "TOTEM", "product_type": "", "tags": [], "variants": [{"id": 52570933035297, "title": "Raw Brass / 1st edition - Camo pattern", "option1": "Raw Brass", "option2": "1st edition - Camo pattern", "option3": null, "sku": null, "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "90.00", "grams": 0, "compare_at_price": null, "position": 1, "product_id": 10320060350753, "created_at": "2026-04-15T14:15:28-04:00", "updated_at": "2026-10-21T11:04:37-04:00"}], "images": [{"id": 55266598584609, "created_at": "2026-04-15T14:11:12-04:00", "position": 1, "updated_at": "2026-04-15T14:11:41-04:00", "product_id": 10320060350753, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0947/7383/8113/files/DSC_0808_ca4bf556-ba25-4671-