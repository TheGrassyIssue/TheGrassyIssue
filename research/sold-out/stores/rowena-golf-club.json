{"domain": "rowenagolf.com", "products": [{"id": 15393841545461, "title": "Griffith Linen Shorts", "handle": "griffith-linen-shorts", "body_html": "<p data-pm-slice=\"1 1 []\"><span>Made for the hottest days on the course.</span></p>\n<p><span>Crafted from a lightweight linen blend that stays breathable through long summer rounds. </span></p>\n<p><span>Double pleats create a relaxed silhouette, while elastic side panels at the waistband provide extra comfort and flexibility throughout the round.</span></p>\n<ul>\n<li data-end=\"1735\" data-start=\"1699\">Linen</li>\n<li data-end=\"1735\" data-start=\"1699\">Double-pleats on the front</li>\n<li data-end=\"1735\" data-start=\"1699\">Relaxed straight-leg fit</li>\n<li data-end=\"1735\" data-start=\"1699\">Elastic sides on waistband</li>\n<li data-end=\"1735\" data-start=\"1699\">Tee pocket</li>\n<li data-end=\"1735\" data-start=\"1699\">Two back pockets</li>\n</ul>\n<p><em>Will is 5'7\" wearing a size 30.\u00a0</em><br></p>\n<p>Wash on cold and air dry. All orders are final.</p>\n<p>\u00a0</p>", "published_at": "2026-09-27T10:39:38-07:00", "created_at": "2026-09-27T10:15:10-07:00", "updated_at": "2026-10-21T08:04:44-07:00", "vendor": "Rowena Golf Club", "product_type": "", "tags": [], "variants": [{"id": 67583142101237, "title": "Navy Pinstripes / 30", "option1": "Navy Pinstripes", "option2": "30", "option3": null, "sku": null, "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "78.00", "grams": 0, "compare_at_price": null, "position": 1, "product_id": 15393841545461, "created_at": "2026-09-27T10:22:31-07:00", "updated_at": "2026-10-21T08:04:44-07:00"}, {"id": 67583142134005, "title": "Navy Pinstripes / 32", "option1": "Navy Pinstripes", "option2": "32", "option3": null, "sku": null, "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "78.00", "grams": 136, "compare_at_price": null, "position": 2, "product_id": 15393841545461, "cre