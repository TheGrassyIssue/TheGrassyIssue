2/7207/3513/files/IMG_9252_5a6419f9-8a3c-4982-87df-5a6e01247f30.jpg?v=1767121313", "width": 1426, "height": 1901}, {"id": 46974935171369, "created_at": "2024-07-18T19:47:39-06:00", "position": 6, "updated_at": "2025-04-24T18:36:11-06:00", "product_id": 9103147041065, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/Copy_of_Your_Boat_Retarget_Paid.png?v=1745541371", "width": 1080, "height": 1080}, {"id": 49709976125737, "created_at": "2025-02-13T22:04:24-07:00", "position": 7, "updated_at": "2025-04-24T22:09:28-06:00", "product_id": 9103147041065, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/IMG_8799.jpg?v=1745554168", "width": 3899, "height": 3899}], "options": [{"name": "Style", "position": 1, "values": ["Your Boat on a Belt", "Your Story on a Belt"]}]}, {"id": 8923836088617, "title": "Bespoke Yachtsman Belt", "handle": "bespoke-yachtsman-belt", "body_html": "<p>Your boat, hand-stitched on a needlepoint belt. Design yours in Belt Studio with your boat, her name and hailing port, signal flags or your club burgee, see it instantly, and pay one flat $189.</p><h3>How to design your boat belt</h3><ol>\n<li>\n<strong>Design it live.</strong> Upload a photo of your boat, add transom text with her name and hailing port, spell initials in nautical signal flags, and add icons from 400+ designs.</li>\n<li>\n<strong>Perfect it with our team.</strong> After you order, our team emails you to fine-tune every detail with our designers. Nothing is stitched until it's just right.</li>\n<li>\n<strong>Hand-stitched for you.</strong> Your belt is stitched by hand and arrives in 12 weeks.</li>\n</ol><p>Every belt is 100% hand-stitched with a cowhide leather backing and a solid brass buckle, made to last as long as your love for the water. Not a boat person? Design any <a href=\"/products/custom-needlepoint-belt\">custom needlepoint belt</a>.</p><h3>FAQs</h3><p><strong>How much does a custom boat belt cost?</strong> $189 flat, including your boat.</p><p><strong>How long does it take?</strong> 12 weeks from order to delivery.</p><p><strong>How do I find my size?</strong> See our <a href=\"/pages/belt-sizing-guide\">belt sizing guide</a>.</p>", "published_at": "2024-01-14T14:47:18-07:00", "created_at": "2024-01-14T14:45:19-07:00", "updated_at": "2026-10-21T09:04:44-06:00", "vendor": "Fish Creek Brands", "product_type": "Belt", "tags": ["needlepoint_belt"], "variants": [{"id": 49288143503657, "title": "Default Title", "option1": "Default Title", "option2": null, "option3": null, "sku": "FCB-BLT-CSTM-YACHT-NEW", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "189.00", "grams": 213, "compare_at_price": null, "position": 3, "product_id": 8923836088617, "created_at": "2024-09-18T20:09:59-06:00", "updated_at": "2026-10-21T09:04:44-06:00"}], "images": [{"id": 45359604400425, "created_at": "2024-04-07T08:44:52-06:00", "position": 1, "updated_at": "2026-03-02T20:59:00-07:00", "product_id": 8923836088617, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/IMG_0456.jpg?v=1772510340", "width": 2847, "height": 2847}, {"id": 54811546878249, "created_at": "2026-03-02T20:51:30-07:00", "position": 2, "updated_at": "2026-03-02T20:59:00-07:00", "product_id": 8923836088617, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/IMG_1045.jpg?v=1772510340", "width": 2048, "height": 2048}, {"id": 48298015228201, "created_at": "2024-10-24T19:25:44-06:00", "position": 3, "updated_at": "2026-03-02T20:59:00-07:00", "product_id": 8923836088617, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/IMG_9990_1.jpg?v=1772510340", "width": 2287, "height": 2287}, {"id": 54813357048105, "created_at": "2026-03-02T21:33:39-07:00", "position": 4, "updated_at": "2026-03-02T21:33:58-07:00", "product_id": 8923836088617, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/Pair_with_a_Matching_Key_Fob.png?v=1772512438", "width": 2048, "height": 2048}, {"id": 54811546812713, "created_at": "2026-03-02T20:51:30-07:00", "position": 5, "updated_at": "2026-03-02T21:33:58-07:00", "product_id": 8923836088617, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/IMG_1133.jpg?v=1772512438", "width": 2048, "height": 2048}, {"id": 44345120588073, "created_at": "2024-01-20T15:09:28-07:00", "position": 6, "updated_at": "2026-03-02T21:33:58-07:00", "product_id": 8923836088617, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/Screenshot2022-07-23170758.png?v=1772512438", "width": 687, "height": 687}, {"id": 45359602303273, "created_at": "2024-04-07T08:44:37-06:00", "position": 7, "updated_at": "2026-03-02T21:33:58-07:00", "product_id": 8923836088617, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/IMG_0658.jpg?v=1772512438", "width": 2847, "height": 2847}], "options": [{"name": "Title", "position": 1, "values": ["Default Title"]}]}, {"id": 8729370231081, "title": "Custom Needlepoint Belt", "handle": "custom-needlepoint-belt", "body_html": "<p>A Fish Creek needlepoint belt is 100% hand-stitched, with a cowhide leather backing and a solid brass buckle. Design yours in Belt Studio, see it instantly, and pay one flat $189 for any design, including your own logo or photos.</p><h3>How to design your needlepoint belt</h3><ol>\n<li>\n<strong>Design it live.</strong> Pick your belt color, then add icons from 400+ designs, initials, text or nautical signal flags, or upload your own image.</li>\n<li>\n<strong>Perfect it with our team.</strong> After you order, our team emails you to fine-tune every detail with our designers. Nothing is stitched until it's just right.</li>\n<li>\n<strong>Hand-stitched for you.</strong> Your belt is stitched by hand and arrives in 12 weeks.</li>\n</ol><h3>A needlepoint belt for golf, the boat and every occasion</h3><p>Golf courses, dogs, schools, hobbies and inside jokes all fit. Have a boat? Our <a href=\"/products/bespoke-yachtsman-belt\">Yachtsman needlepoint belt</a> puts her name and your burgee front and center.</p><h3>What is a needlepoint belt?</h3><p>A band of canvas stitched by hand, one stitch at a time, then finished with leather and a buckle. It's a classic gift for the man who has everything.</p><h3>FAQs</h3><p><strong>How much does a custom needlepoint belt cost?</strong> $189 flat, for any design.</p><p><strong>Can I use my own logo or photos?</strong> Yes. Custom icons are free.</p><p><strong>How long does it take?</strong> 12 weeks from order to delivery.</p><p><strong>How do I find my size?</strong> See our <a href=\"/pages/belt-sizing-guide\">belt sizing guide</a>.</p>", "published_at": "2023-10-24T18:00:47-06:00", "created_at": "2023-09-29T16:02:06-06:00", "updated_at": "2026-10-21T09:04:44-06:00", "vendor": "Fish Creek Brands", "product_type": "", "tags": ["needlepoint_belt"], "variants": [{"id": 49422166196521, "title": "Default Title", "option1": "Default Title", "option2": null, "option3": null, "sku": "FCB-BLT-CSTM-NEW", "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "189.00", "grams": 213, "compare_at_price": null, "position": 2, "product_id": 8729370231081, "created_at": "2024-10-30T13:33:42-06:00", "updated_at": "2026-10-21T09:04:44-06:00"}], "images": [{"id": 44322794799401, "created_at": "2024-01-18T21:26:57-07:00", "position": 1, "updated_at": "2025-12-01T20:06:38-07:00", "product_id": 8729370231081, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/IMG_9252.jpg?v=1764644798", "width": 3024, "height": 4032}, {"id": 42861232324905, "created_at": "2023-09-29T17:31:52-06:00", "position": 2, "updated_at": "2025-12-01T20:06:38-07:00", "product_id": 8729370231081, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0832/7207/3513/files/fish-creek-brands-custom-needlepoi