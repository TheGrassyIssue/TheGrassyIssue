-d39fff26c0f4.png?v=1769626033", "width": 972, "height": 612}, {"id": 40186228867210, "created_at": "2026-01-28T11:47:39-07:00", "position": 4, "updated_at": "2026-01-28T11:47:40-07:00", "product_id": 8850518179978, "variant_ids": [47621344460938], "src": "https://cdn.shopify.com/s/files/1/0705/2315/8666/files/375_Gift_Card_42fbb304-bbb4-41dc-a6c4-d6d44b27b198.png?v=1769626060", "width": 972, "height": 612}, {"id": 40186229522570, "created_at": "2026-01-28T11:48:03-07:00", "position": 5, "updated_at": "2026-01-28T11:48:04-07:00", "product_id": 8850518179978, "variant_ids": [47621344493706], "src": "https://cdn.shopify.com/s/files/1/0705/2315/8666/files/500_Gift_Card_9de50553-3181-4261-a4ab-6cde84291f20.png?v=1769626084", "width": 972, "height": 612}], "options": [{"name": "Denominations", "position": 1, "values": ["$75.00", "$125.00", "$250.00", "$375.00", "$500.00"]}]}, {"id": 8632937644170, "title": "Desert Roadrunner \u00b7 30mm Copper Ball Marker", "handle": "desert-roadrunner-ball-marker", "body_html": "<p data-end=\"134\" data-start=\"65\">A nod to the desert, built for the green.</p>\n<p data-end=\"289\" data-start=\"136\">Cooler than a polar bear's toe nails \u2014 but as hot as the Sonoran sun. The desert roadrunner moves fast, plays smart, and always knows where it's going.</p>\n<p data-end=\"487\" data-start=\"291\">Cut from solid copper and weighing in at 21 grams, this 30mm marker features a Show Out icon - the desert roadrunner in shades framed by a Southwestern tribal pattern.</p>\n<p data-end=\"647\" data-start=\"546\"><strong data-end=\"556\" data-start=\"546\">Specs:</strong><br data-end=\"559\" data-start=\"556\">\u2013 30mm diameter<br data-end=\"577\" data-start=\"574\">\u2013 3mm thick<br data-end=\"591\" data-start=\"588\">\u2013 21g solid copper<br data-end=\"611\" data-start=\"608\">\u2013 Laser-engraved and hand-finished</p>", "published_at": "2025-09-22T18:54:40-07:00", "created_at": "2025-07-27T18:53:12-07:00", "updated_at": "2026-10-21T08:04:31-07:00", "vendor": "Show Out Engraving", "product_type": "", "tags": ["custom engraving", "gift", "personalized"], "variants": [{"id": 46543362818186, "title": "Default Title", "option1": "Default Title", "option2": null, "option3": null, "sku": null, "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "50.00", "grams": 21, "compare_at_price": null, "position": 1, "product_id": 8632937644170, "created_at": "2025-07-27T18:53:12-07:00", "updated_at": "2026-10-21T08:04:31-07:00"}], "images": [{"id": 38712158224522, "created_at": "2025-07-27T18:30:07-07:00", "position": 1, "updated_at": "2025-07-27T19:29:57-07:00", "product_id": 8632937644170, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0705/2315/8666/files/Desert_Roadrunner_Ball_Marker_Hero.jpg?v=1753669797", "width": 887, "height": 1182}, {"id": 38712156913802, "created_at": "2025-07-27T18:29:56-07:00", "position": 2, "updated_at": "2025-07-27T19:29:41-07:00", "product_id": 8632937644170, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0705/2315/8666/files/Desert_Roadrunner_Ball_Marker.jpg?v=1753669781", "width": 887, "height": 1182}], "options": [{"name": "Title", "position": 1, "values": ["Default Title"]}]}, {"id": 8679766556810, "title": "Custom Portrait Ball Marker", "handle": "custom-ball-marker", "body_html": "<p data-start=\"180\" data-end=\"254\">Turn your favorite photos into a custom portrait ball marker.</p>\n<p data-start=\"256\" data-end=\"599\">Each marker is individually created from customer-submitted photographs and engraved on a 1.25\" brass marker. Whether it's a portrait of yourself, family members, loved ones, a favorite athlete, a beloved pet, or even a spirit animal, every marker is crafted one at a time by Show Out Engraving in Gilbert, Arizona. The rear of the coin is engraved with the Desert Roadrunner logo.\u00a0</p>\n<h4 data-section-id=\"1qw470j\" data-start=\"1213\" data-end=\"1227\">How to Buy</h4>\n<ol data-start=\"1229\" data-end=\"1485\">\n<li><span>Select your material and place your order.</span></li>\n<li><span>Following checkout, customers receive instructions for submitting their photo.</span></li>\n<li><span>Show Out Engraving creates the artwork and engraves the marker.</span></li>\n<li>\n<span>The finished marker is packaged and shipped directly to your door.</span><br>\n</li>\n</ol>\n<blockquote></blockquote>", "published_at": "2025-09-22T16:18:46-07:00", "created_at": "2025-09-22T15:58:18-07:00", "updated_at": "2026-10-21T08:04:31-07:00", "vendor": "Show Out Engraving", "product_type": "Ball Marker", "tags": ["custom engraving", "gift", "personalized", "post_purchase_portrait_marker"], "variants": [{"id": 49558193635466, "title": "Brass - 30mm", "option1": "Brass - 30mm", "option2": null, "option3": null, "sku": null, "requires_shipping": true, "taxable": true, "featured_image": null, "available": true, "price": "75.00", "grams": 454, "compare_at_price": null, "position": 1, "product_id": 8679766556810, "created_at": "2026-06-16T11:43:00-07:00", "updated_at": "2026-10-21T08:04:31-07:00"}], "images": [{"id": 41402744635530, "created_at": "2026-06-16T11:33:49-07:00", "position": 1, "updated_at": "2026-06-16T11:33:51-07:00", "product_id": 8679766556810, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0705/2315/8666/files/IMG_8904.jpg?v=1781634831", "width": 1536, "height": 2048}, {"id": 41402744602762, "created_at": "2026-06-16T11:33:49-07:00", "position": 2, "updated_at": "2026-06-16T11:33:51-07:00", "product_id": 8679766556810, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0705/2315/8666/files/IMG_8891.jpg?v=1781634831", "width": 1536, "height": 2048}, {"id": 41402744569994, "created_at": "2026-06-16T11:33:49-07:00", "position": 3, "updated_at": "2026-06-16T11:33:51-07:00", "product_id": 8679766556810, "variant_ids": [], "src": "https://cdn.shopify.com/s/files/1/0705/2315/8666/files/IMG_8885.jpg?v=1781634831", "width": 1536, "he