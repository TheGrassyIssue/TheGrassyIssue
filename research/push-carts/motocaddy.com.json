<script>
    require(['jquery'], function (jQuery) {

        function clearSearch() {
            if (jQuery('#search_mini_form #search').val() == '') {
                jQuery('.clear-search').removeClass('active');
            } else {
                jQuery('.clear-search').addClass('active')
            }
        }

        jQuery('#search_autocomplete').on('DOMSubtreeModified', function() {
            setTimeout(() => {
                if (jQuery('#search_mini_form #search').val() == '' || jQuery('#search_autocomplete').html().length == 0) {
                    jQuery('body').removeClass('active-search');
                } else {
                    jQuery('body').addClass('active-search');
                }
            }, "100");

        });

        jQuery('#search_mini_form #search').on('input', function() {
            clearSearch();
        });

        jQuery('.clear-search').on('click', function(event) {
            event.preventDefault();
            jQuery('#search_mini_form #search').val('');
            jQuery('#search_mini_form #search').focus();
            clearSearch();
        });
    });
</script>
