	var stickyNav = document.getElementById('sticky-nav');
	var infolinePopup = document.getElementById('infoline-popup');
	var infolineBtn = document.getElementById('infoline-btn');
	var cataloguePopup = document.getElementById('catalogue-popup');
	var catalogueBtn = document.getElementById('catalogue-btn');

	if(stickyNav) stickyNav.style.display = 'block';

	if(catalogueBtn) {
		catalogueBtn.addEventListener('click', function () {
			infolinePopup.classList.remove('active');
			infolineBtn.classList.remove('active');
			stickyNav.classList.remove('active');
			cataloguePopup.classList.add('active');
			catalogueBtn.classList.add('active');
		})
	}

	var catalogueCloseBtn = document.querySelector('.catalogue-close');
	if(catalogueCloseBtn) {
		catalogueCloseBtn.addEventListener('click', function () {
			cataloguePopup.classList.remove('active');
			catalogueBtn.classList.remove('active');
			stickyNav.classList.remove('active');
			infolinePopup.classList.remove('active');
			infolineBtn.classList.remove('active');
		})
	}


	if(infolineBtn) {
		infolineBtn.addEventListener('click', function () {
			infolinePopup.classList.add('active');
			infolineBtn.classList.add('active');
			cataloguePopup.classList.remove('active');
			catalogueBtn.classList.remove('active');
		})
	}

	var infolineBtnInline = Array.prototype.slice.call(document.querySelectorAll('.infoline-btn-inline'));
	if(infolineBtnInline) {
		infolineBtnInline.forEach(function (btn) {
			btn.addEventListener('click', function (e) {
				e.preventDefault();
				console.log('clicked');
				infolineBtn.classList.add('active');
				infolinePopup.classList.add('active');
				cataloguePopup.classList.remove('active');
				catalogueBtn.classList.remove('active');
			})
		});
	}

	var infolineCloseBtn = document.querySelector('.infoline-close');
	if(infolineCloseBtn) {
		infolineCloseBtn.addEventListener('click', function () {
			infolinePopup.classList.remove('active');
			infolineBtn.classList.remove('active');
			stickyNav.classList.remove('active');
			cataloguePopup.classList.remove('active');
			catalogueBtn.classList.remove('active');
		})
	}


	setTimeout(function () {
		if(document.getElementById('caddyfinder') && !document.getElementById('caddyfinder').classList.contains('bagfinder')) {
			setTimeout(function () {
				infolineBtn.click();
			}, 10000)
		}
	}, 10000)
</script>

<script>
	(function () {
		if (!window.fetch || !document.documentElement.closest) return;

		var reveal = function () {
			var blocks = Array.prototype.slice.call(document.querySelectorAll('[data-klaviyo-form-id]'));
			if (!blocks.length) return;
			// The Klaviyo plugin renders this element only on sales channels it is enabled for,
			// and it sits after the footer in the document, hence DOMContentLoaded.
			var tracking = document.querySelector('[data-klaviyo-tracking-options]');
			if (!tracking) return;
			var companyId = '';
			try {
				companyId = JSON.parse(tracking.getAttribute('data-klaviyo-tracking-options')).publicApiKey || '';
			} catch (e) {}
			if (!companyId) return;

			// Klaviyo's public forms feed lists live forms only; a form set back to draft drops
			// out of it, and so do the triggers. Anything unexpected keeps them hidden.
			fetch('https://static-forms.klaviyo.com/forms/api/v7/' + encodeURIComponent(companyId) + '/full-forms', {mode: 'cors', credentials: 'omit'})
				.then(function (response) { return response.ok ? response.json() : null; })
				.then(function (data) {
					var forms = data && data.full_forms;
					if (!Array.isArray(forms)) return;
					var liveIds = forms.filter(function (form) {
						return form && Array.isArray(form.live_form_versions) && form.live_form_versions.length > 0;
					}).map(function (form) { return form.form_id; });
					blocks.forEach(function (block) {
						if (liveIds.indexOf(block.getAttribute('data-klaviyo-form-id')) !== -1) block.hidden = false;
					});
				})
				.catch(function () {});
		};

		// With "initialize Klaviyo after the first interaction" on, klaviyo.js only loads once
		// the visitor scrolls; a click before that has to load it through the plugin instance.
		// Shopware instantiates storefront plugins asynchronously after DOMContentLoaded, so a
		// very early click may find no instance yet — retry for a few seconds.
		var loadKlaviyo = function (attempt) {
			var plugin = null;
			try {
				plugin = window.PluginManager.getPluginInstances('KlaviyoTracking')[0] || null;
			} catch (err) {}
			if (!plugin) {
				if (attempt < 20) setTimeout(function () { loadKlaviyo(attempt + 1); }, 250);
				return;
			}
			if (!plugin.options.scriptInitialized && plugin.isAllowToTrack()) {
				plugin.markAsInteracted();
				plugin.initKlaviyoScript();
			}
		};

		document.addEventListener('click', function (e) {
			var trigger = e.target.closest ? e.target.closest('[data-klaviyo-form-open]') : null;
			var block = trigger ? trigger.closest('[data-klaviyo-form-id]') : null;
			if (!block) return;
			e.preventDefault();
			Array.prototype.forEach.call(document.querySelectorAll('#sticky-nav .active'), function (el) {
				el.classList.remove('active');
			});
			// push() queues the call until klaviyo.js has loaded (Klaviyo's documented API).
			window._klOnsite = window._klOnsite || [];
			window._klOnsite.push(['openForm', block.getAttribute('data-klaviyo-form-id')]);
			loadKlaviyo(0);
		});

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', reveal);
		} else {
			reveal();
		}
	})();
</script>

<script>
