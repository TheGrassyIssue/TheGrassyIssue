                                <script>
                (function() {
                    var links = document.querySelectorAll('.js-store-switcher-link');
                    var tags = document.querySelectorAll('link[rel="alternate"][hreflang]:not([hreflang="x-default"])');
                    if (!links.length || !tags.length) return;

                    var exactMatches = {};
                    var langMatches = {};

                    tags.forEach(function(tag) {
                        var hreflang = tag.getAttribute('hreflang').toLowerCase();
                        var lang = hreflang.split('-')[0];
                        var url = tag.href;

                        exactMatches[hreflang] = url;

                        // Prefer the bare-language hreflang (e.g. "fr") as the language-level
                        // fallback target over a more specific regional one (e.g. "fr-FR"), so a
                        // generic switcher entry never gets redirected to a country-specific store.
                        var isBareLanguage = hreflang.indexOf('-') === -1;
                        if (isBareLanguage || !(lang in langMatches)) {
                            langMatches[lang] = url;
                        }
                    });

                    links.forEach(function(link) {
                        var storeLocale = link.getAttribute('data-store-locale');
                        if (!storeLocale) return;
                        var storeLang = storeLocale.split('-')[0];

                        if (exactMatches[storeLocale]) {
                            link.href = exactMatches[storeLocale];
                        } else if (langMatches[storeLang]) {
                            link.href = langMatches[storeLang];
                        }
                    });
                })();
                </script>
